CCEffect %{
  techniques:
  - passes:
    - vert: scroll-vs:vert
      frag: scroll-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        overlayTexture: { value: white, editor: { tooltip: 'Image B: independent overlay texture' } }
        overlayColor: { value: [1, 1, 1, 1], editor: { type: color } }
        overlayOpacity: { value: 1, target: overlaySettings.x, editor: { slide: true, range: [0, 1] } }
        overlayMode: { value: 0, target: overlaySettings.y, editor: { tooltip: '0: Tile; 1: Stretch Fill', range: [0, 1], step: 1 } }
        overlayEnabled: { value: 0, target: overlaySettings.z, editor: { tooltip: 'Set to 1 after assigning image B; component sets this automatically', range: [0, 1], step: 1 } }
        clipToBaseAlpha: { value: 1, target: overlaySettings.w, editor: { range: [0, 1], step: 1 } }
        scrollSpeed: { value: [0.15, 0, 1, 1], editor: { tooltip: 'B only: XY velocity; ZW tile repeat counts (ignored by Fill)' } }
        scrollOffset: { value: [0, 0, 0, 0], editor: { tooltip: 'XY: UV offset; ZW: managed clock/coordinate flags (set by component)' } }
        bWorldToLocalX: { value: [1, 0, 0, 0], editor: { visible: false } }
        bWorldToLocalY: { value: [0, 1, 0, 0], editor: { visible: false } }
        bLocalBounds: { value: [-0.5, -0.5, 1, 1], editor: { visible: false } }
}%

CCProgram scroll-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 color;
  out vec2 uv0;
  out vec2 overlayUV;
  uniform GeometryParams {
    vec4 bWorldToLocalX;
    vec4 bWorldToLocalY;
    vec4 bLocalBounds;
  };
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    // B uses node-local geometry, independent of A's atlas UV and rendering mode.
    vec2 localPosition = vec2(dot(bWorldToLocalX, pos), dot(bWorldToLocalY, pos));
    overlayUV = (localPosition - bLocalBounds.xy) / max(bLocalBounds.zw, vec2(0.000001));
    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;
    return pos;
  }
}%

CCProgram scroll-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec4 color;
  in vec2 overlayUV;
  uniform ScrollParams {
    vec4 scrollSpeed;
    vec4 scrollOffset;
    vec4 overlayColor;
    vec4 overlaySettings;
  };
  uniform sampler2D overlayTexture;
  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif
  vec4 frag () {
    vec4 result = vec4(1.0);
    #if USE_TEXTURE
      // A always uses the original SpriteFrame UV. Only B moves.
      result = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
      // No component-provided coordinate system: keep A rather than tile B in world pixels.
      if (overlaySettings.z > 0.5 && scrollOffset.w > 0.5) {
        float time = cc_time.x * (1.0 - scrollOffset.z);
        vec2 scale = overlaySettings.y < 0.5 ? scrollSpeed.zw : vec2(1.0);
        vec2 bUV = fract(overlayUV * scale - scrollSpeed.xy * time - scrollOffset.xy);
        // Local Y points up; independent Texture2D images have their origin at the top.
        vec4 overlay = texture(overlayTexture, vec2(bUV.x, 1.0 - bUV.y)) * overlayColor;
        float alpha = clamp(overlay.a * overlaySettings.x, 0.0, 1.0);
        if (overlaySettings.w > 0.5) {
          result.rgb = mix(result.rgb, overlay.rgb, alpha);
        } else {
          float combinedAlpha = alpha + result.a * (1.0 - alpha);
          vec3 premultiplied = overlay.rgb * alpha + result.rgb * result.a * (1.0 - alpha);
          result = vec4(premultiplied / max(combinedAlpha, 0.000001), combinedAlpha);
        }
      }
      #if IS_GRAY
        float gray = dot(result.rgb, vec3(0.2126, 0.7152, 0.0722));
        result.rgb = vec3(gray);
      #endif
    #endif
    result *= color;
    ALPHA_TEST(result);
    return result;
  }
}%
