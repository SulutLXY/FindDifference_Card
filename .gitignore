# Cocos Creator 生成的缓存与构建产物（可再生，不入库）
library/
temp/
build/
local/
profiles/

# 系统与编辑器杂项
.DS_Store
Thumbs.db
*.swp

# Python 工具脚本缓存
__pycache__/
*.pyc

# 可重新生成的 H5 独立发布包（约 100 MB）
output/web-mobile-release/

# Server runtime statistics; retain through a persistent volume, never commit player events.
server/play-stats/data/
server/play-stats/*.sqlite*
output/play-stats-service-*.zip

# Font previews/subset exports and local Python dependencies are reproducible.
output/font-matching/
output/git-validation/
