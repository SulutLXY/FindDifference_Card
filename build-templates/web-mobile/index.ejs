<%
  const webBuildId = Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);
%>
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="find-difference-build" content="<%= webBuildId %>">
  <script>
  (function () {
    var build = '<%= webBuildId %>';
    var redirecting = false;
    function checkRelease() {
      // 只检查当前游戏目录，不读取或删除玩家存档。
      var entry = new URL('index.html', window.location.href);
      entry.searchParams.set('_fd_check', Date.now().toString(36) + Math.random().toString(36).slice(2));
      var controller = typeof AbortController === 'function' ? new AbortController() : null;
      var timer = controller ? setTimeout(function () { controller.abort(); }, 8000) : null;
      return fetch(entry.href, { cache: 'no-store', credentials: 'same-origin', signal: controller ? controller.signal : undefined })
        .then(function (response) {
          if (!response.ok) throw new Error('入口版本检查失败：' + response.status);
          return response.text();
        }).then(function (html) {
          if (timer) clearTimeout(timer);
          var match = /<meta\s+name="find-difference-build"\s+content="([a-z0-9-]+)"\s*\/?\s*>/i.exec(html);
          if (!match || match[1] === build) return;
          var latest = match[1];
          var target = new URL(window.location.href);
          if (target.searchParams.get('_fd_release') === latest) {
            var stale = new Error('服务器入口缓存尚未刷新，请刷新 CDN 的 index.html 缓存后重试');
            stale.blockStartup = true;
            throw stale;
          }
          target.searchParams.set('_fd_release', latest);
          redirecting = true;
          window.location.replace(target.href);
          return new Promise(function () {});
        }).catch(function (error) {
          console.warn('[WebRelease]', error);
          if (error.blockStartup) {
            document.getElementById('WebReleaseError').hidden = false;
            return new Promise(function () {});
          }
          // 网络异常仍可使用当前构建；MD5 文件名保持其依赖一致。
        }).finally(function () { if (timer) clearTimeout(timer); });
    }
    window.__webReleaseReady = checkRelease();
    window.addEventListener('pageshow', function (event) {
      if (event.persisted && !redirecting) checkRelease();
    });
  }());
  </script>

  <title>Cocos Creator | <%= projectName %></title>

  <!--http://www.html5rocks.com/en/mobile/mobifying/-->
  <meta name="viewport"
        content="width=device-width,user-scalable=no,initial-scale=1,minimum-scale=1,maximum-scale=1,minimal-ui=true"/>

  <!--https://developer.apple.com/library/safari/documentation/AppleApplications/Reference/SafariHTMLRef/Articles/MetaTags.html-->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="format-detection" content="telephone=no">

  <!-- force webkit on 360 -->
  <meta name="renderer" content="webkit"/>
  <meta name="force-rendering" content="webkit"/>
  <!-- force edge on IE -->
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/>
  <meta name="msapplication-tap-highlight" content="no">

  <!-- force full screen on some browser -->
  <meta name="full-screen" content="yes"/>
  <meta name="x5-fullscreen" content="true"/>
  <meta name="360-fullscreen" content="true"/>

  <!--fix fireball/issues/3568 -->
  <!--<meta name="browsermode" content="application">-->
  <meta name="x5-page-mode" content="app">

  <!--<link rel="apple-touch-icon" href=".png" />-->
  <!--<link rel="apple-touch-icon-precomposed" href=".png" />-->

  <link rel="stylesheet" type="text/css" href="<%= cssUrl %>"/>
  <style>
    /* Cocos 的 body, canvas, div { display:block } 会覆盖浏览器默认 hidden 样式。 */
    #WebReleaseError[hidden] { display: none !important; }
  </style>

</head>
<body>
  <div id="WebReleaseError" hidden style="position:fixed;inset:0;z-index:99999;background:#fff;padding:32px;text-align:center">
    <p>新版本正在更新，请稍后重新加载。</p>
    <button onclick="window.location.reload()">重新加载</button>
  </div>
  <div id="GameDiv" cc_exact_fit_screen="true">
      <div id="Cocos3dGameContainer">
        <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="99"></canvas>
      </div>
    </div>
  <%- include(cocosTemplate, {})
    .replace(/System\.import\(([^)]+)\)/, 'window.__webReleaseReady.then(function () { return System.import($1); })') %>
</body>
</html>
